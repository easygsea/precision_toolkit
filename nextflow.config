manifest {
    name = 'precision_toolkit'
    homePage = 'https://github.com/easygsea/precision_toolkit'
    description = 'Clinical Genomics Assay Development and Validation Tools'
    mainScript = 'main.nf'
    defaultBranch = 'main'
    nextflowVersion = '!>=25.04.6'
}

params {
    // Comma-separated list of workflows to run
    workflows = null

    // Directory storing output files
    output_dir = "output_precision_toolkit"
    // subdirectory for variant benchmark outputs
    variant_benchmark_subdir = "variant_benchmark"
    // subdirectory for target evaluation outputs
    target_evaluation_subdir = "target_evaluation"

    // Genome reference fasta file
    genome_ref = null

    // General formatting parameters
    decimals = 2
    color_palette = "colorblind"

    // Variant benchmark workflow parameters
    // directory containing truth VCFs
    truth_dir = null
    // directory containing query VCFs
    query_dir = null
    // options: "happy" or "wittyer"
    variant_benchmark_engine = "happy"
    // default is all metrics
    diagnostic_metrics = "concordance sensitivity precision f1_score"
    // option to output all data csv
    include_all_data_csv = false

    // Variant concordance parameter
    // Method for defining TP in concordance: "truth", "query", or "min" (default)
    concordance_tp = "min"

    // hap.py configuration parameters
    // Options: "vcfeval", "xcmp", "scmp-distance", "scmp-somatic"
    happy_engine = "vcfeval"
    // default options for happy
    happy_options = "--write-vcf --write-counts"

    // som.py configuration parameters
    // include non-PASS variants in the analysis
    sompy_options = "--include-nonpass"

    // Truvari configuration parameters
    // default options for truvari bench
    truvari_bench_options = "--refdist 5000 --chunksize 10000 --sizemax -1"
    // option to run truvari refine after truvari bench
    enable_refine = false
    // default options for truvari refine
    truvari_refine_options = "--use-original-vcfs"

    // Witty.er configuration parameters
    // Evaluation mode: CrossTypeAndSimpleCounting|SimpleCounting|GenotypeMatching
    evaluationMode = "CrossTypeAndSimpleCounting"
    // Comma-separated list of filters to include
    includedFilters = ""
    // Percentage distance threshold (0.0-1.0)
    percentDistance = 0.3
    // Base pair distance threshold
    bpDistance = 5000
    // Construct wittyer options using original parameter names
    wittyer_options = "--evaluationMode=${params.evaluationMode} " + "--includedFilters=${params.includedFilters} " + "--percentDistance=${params.percentDistance} " + "--bpDistance=${params.bpDistance}"

    // Path to VCF file with spurious variants to exclude
    spurious_variants_vcf = null
    // collapse option for bcftools isec
    // TO-DO: CDI-89 upgrade bcftools and default collapse option per official fix
    collapse = "none"
    // skip raw analysis (only available when spurious_variants_vcf is provided)
    skip_raw = false

    // Signal correlation workflow parameters
    // signal name from the truth VCF files e.g. VAF AF LR
    truth_signal = null
    // signal name from the query VCF files e.g. VAF AF LR
    query_signal = null
    // x-axis limits for the figure e.g. "0 1"
    xlim = ""
    // y-axis limits for the figure e.g. "0 1"
    ylim = ""
    // show regression line and equation
    show_regression = false
    // Column to use for coloring ('', 'truth', 'query', or 'run')
    color_source = ""
    // Run pattern (eg. 'AB\\d{5}' or "AB\\\d{5}")
    run_pattern = ""

    // Target evaluation workflow parameters
    // Required
    // glob expression matching one or more bam/cram file paths (eg. 'path/to/dir/*.bam')
    aligned_files = null
    // BED file including Target names in the 4th column
    targets_bed = null
    // Optional
    // flag to separate plots for metrics when generating visualizations for regions failing to meet threshold
    separate_plots = false
    // flag to output raw mpileup file
    output_raw_mpileup = false
    //If set, coverage across the targets bed for every sample is normalized and scaled to center on this value
    normalize_coverage = null
    // enum option to normalize by median or mean in normalization step (default = 'mean')
    normalization_method = 'mean'
    // flag to generate plots for each stat
    visualize = false
    // Fine-tuning
    // maximum tolerable percentage of libraries failing at this base for base-level PASS across all libraries (non-inclusive)
    cohort_percent_library_fail_threshold = 0.25
    // minimum acceptable value for coverage per base (inclusive)
    coverage_threshold = 25
    // minimum acceptable BASEQ score at the percentile defined by `read_fail_tolerance` of mapped reads per base (inclusive)
    baseq_threshold = 30
    // minimum acceptable MAPQ score at the percentile defined by `read_fail_tolerance` of mapped reads per base (inclusive)
    mapq_threshold = 30
    // maximum tolerable percentage of reads per base failing baseq and mapq thresholds (non-inclusive)
    read_fail_tolerance = 0.25
    // maximum tolerable percentage of bases failed for target-level PASS per sample (non-inclusive)
    target_fail_tolerance = 0.25
    // gap tolerance when building tracts, max gap between two fail regions to include in the same tract
    tract_gap_tolerance = 2
    // In development
    min_bq_per_read {
        // custom filtering parameters for each metric (base quality)
        coverage_analysis = 10
        mapq_analysis = 10
        baseq_analysis = 0
    }
    min_mq_per_read {
        // custom filtering parameters for each metric (map quality)
        coverage_analysis = 1
        mapq_analysis = 0
        baseq_analysis = 1
    }
    // glob expression (similar to --aligned_files) to compare against
    query_files = null
    //outputs all files for publishDir <path>, enabled = params.debug
    debug_mode = false

    // Resource limits
    max_memory = "64.GB"
    max_cpus = 16

    // SLURM specific parameters
    slurm_account = null
    slurm_queue = null

    // Statistical method for confidence interval calculation
    ci_method = "wilson"
    // Options: "agresti_coull", "beta", "binom_test", "jeffreys", "normal", "wilson"
    ci_level = 0.95
}

process {
    container = "quay.io/easygsea/precision_toolkit:v1.4.1"
    resourceLimits = [cpus: params.max_cpus, memory: params.max_memory]
    withLabel: dynamic_resource {
        cpus = {
            if (task.attempt == 1) {
                return 4
            }
            if (task.attempt == 2) {
                return 6
            }
            return Math.min(8, params.max_cpus ?: 8)
        }
        memory = {
            if (task.attempt == 1) {
                return "8 GB"
            }
            if (task.attempt == 2) {
                return "16 GB"
            }
            return "32 GB"
        }
        time = {
            if (task.attempt == 1) {
                return "4h"
            }
            if (task.attempt == 2) {
                return "8h"
            }
            return "12h"
        }
        errorStrategy = {
            return task.exitStatus in [104, 134, 137, 139, 140, 143] ? "retry" : "terminate"
        }
    }
    maxRetries = 5
}

profiles {
    standard {
        process {
            executor = "local"
            cpus = 2
            memory = "4 GB"

            withLabel: dynamic_resource {
                time = "24h"
            }
        }
    }

    slurm {
        process {
            executor = "slurm"
            queue = params.slurm_queue
            clusterOptions = params.slurm_account ? "--account=${params.slurm_account}" : null
            cpus = 2
            memory = "4 GB"
        }
    }
}

apptainer {
    enabled = true
    autoMounts = true
}

cleanup = true
