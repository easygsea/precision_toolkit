manifest {
    name            = 'clinical_tools'
    homePage        = 'https://github.com/easygsea/clinical_tools'
    description     = 'Clinical Genomics Assay Development and Validation Tools'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=24.10.3'
}

params {
    // Comma-separated list of workflows to run
    workflows = null

    // Directory storing output files
    output_dir = "output_clinical_tools"
    variant_benchmark_dir = "variant_benchmark"  // subdirectory for variant benchmark outputs
    target_evaluation_dir = "target_evaluation" // subdirectory for target evaluation outputs

    // Genome reference fasta file
    // genome_ref = "/projects/alignment_references/Homo_sapiens/hg38_no_alt/genome/fasta/hg38_no_alt.fa"
    // genome_ref = "/projects/gsc_clinical_dev/database/genome_reference/hg19_decoy/genome.fa"
    genome_ref = null

    // Number of decimal places
    decimals = 2

    // Variant benchmark workflow parameters
    truth_dir = null // directory containing truth VCFs
    query_dir = null // directory containing query VCFs
    variant_benchmark_engine = "happy" // options: "happy" or "wittyer"
    diagnostic_metrics = "concordance sensitivity precision f1_score" // default is all metrics
    include_all_data_csv = false // option to output all data csv

    // Variant concordance parameter
    concordance_tp = "min" // Method for defining TP in concordance: "truth", "query", or "min" (default)

    // hap.py configuration parameters
    happy_engine = "vcfeval"  // Options: "vcfeval", "xcmp", "scmp-distance", "scmp-somatic"
    happy_options = "--write-vcf --write-counts" // default options for happy

    // som.py configuration parameters
    sompy_options = "--include-nonpass" // include non-PASS variants in the analysis

    // Witty.er configuration parameters
    evaluationMode = "CrossTypeAndSimpleCounting"  // Evaluation mode: CrossTypeAndSimpleCounting|SimpleCounting|GenotypeMatching
    includedFilters = ""  // Comma-separated list of filters to include
    percentDistance = 0.3  // Percentage distance threshold (0.0-1.0)
    bpDistance = 5000  // Base pair distance threshold
    // Construct wittyer options using original parameter names
    wittyer_options = "--evaluationMode=${params.evaluationMode} " +
                     "--includedFilters=${params.includedFilters} " +
                     "--percentDistance=${params.percentDistance} " +
                     "--bpDistance=${params.bpDistance}"

    spurious_variants_vcf = null // Path to VCF file with spurious variants to exclude
    // TO-DO: CDI-89 upgrade bcftools and default collapse option per official fix
    collapse = "none" // collapse option for bcftools isec
    skip_raw = false // skip raw analysis (only available when spurious_variants_vcf is provided)

    // Signal correlation workflow parameters
    truth_signal = null // signal name from the truth VCF files e.g. VAF AF LR
    query_signal = null // signal name from the query VCF files e.g. VAF AF LR
    xlim = "" // x-axis limits for the figure e.g. "0 1"
    ylim = "" // y-axis limits for the figure e.g. "0 1"
    show_regression = false // show regression line and equation
    filter_source = "" // FILTER column to use for coloring ('', 'truth', or 'query')

    // Target evaluation workflow parameters
    aligned_files = null // glob expression matching one or more bam/cram file paths (eg. 'path/to/dir/*.bam')
    targets_bed = null // BED file including Target names in the 4th column
    // Optional
    coverage_threshold = 25 // minimum acceptable value for coverage per base
    baseq_threshold = 30 // minimum acceptable first quartile (Q1) of the BASEQ scores of mapped reads per base
    mapq_threshold = 30 // minimum acceptable first quartile (Q1) of the MAPQ scores of mapped reads per base
    visualize = false // optional flag to generate plots for each stat
    output_raw_mpileup = false // optional flag to output raw mpileup file
    min_bq_per_read { // custom filtering parameters for each metric (base quality)
        coverage_analysis = 10
        mapq_analysis = 10
        baseq_analysis = 0
    }
    min_mq_per_read {  // custom filtering parameters for each metric (map quality)
        coverage_analysis = 1
        mapq_analysis = 0
        baseq_analysis = 1
    }
    // In development
    normalize_to_mean_coverage = null // If set, coverage will be normalized to match the provided mean
    query_files = null // glob expression (similar to --aligned_files) to compare against

    // Resource limits
    max_memory = "64.GB"
    max_cpus = 16

    // SLURM specific parameters with help messages
    slurm_account = null // Your SLURM account name
    slurm_queue = "general" // SLURM partition to use (default: general)

    // Statistical method for confidence interval calculation
    ci_method = "wilson"  // Options: "agresti_coull", "beta", "binom_test", "jeffreys", "normal", "wilson"
    ci_level = 0.95  // Confidence level for concordance, sensitivity, and precision confidence intervals
}

process {
    container = "quay.io/easygsea/clinical_tools:v1.1.0"
    withLabel: "dynamic_resource" {
        cpus = {
            if (task.attempt == 1) return 4
            if (task.attempt == 2) return 6
            return Math.min(8, params.max_cpus ?: 8)
        }

        memory = {
            if (task.attempt == 1) return "8 GB"
            if (task.attempt == 2) return "16 GB"
            return "32 GB"
        }

        time = {
            if (task.attempt == 1) return "4h"
            if (task.attempt == 2) return "8h"
            return "12h"
        }

        errorStrategy = {
            switch(task.exitStatus) {
                case 104: return "retry"  // Disk quota exceeded
                case 134: return "retry"  // Assert failed
                case 137: return "retry"  // Out of memory
                case 139: return "retry"  // Segmentation fault
                case 140: return "retry"  // Aborted
                case 143: return "retry"  // Timeout
                default: return "terminate"
            }
        }
    }
    maxRetries = 5
}

profiles {
    standard {
        process {
            executor = "local"
            cpus = 2
            memory = "4 GB"

            withLabel: "dynamic_resource" {
                time = "24h"
            }
        }
    }

    slurm {
        process {
            executor = "slurm"
            queue = params.slurm_queue ?: null
            clusterOptions = params.slurm_account ? "--account=${params.slurm_account}" : null
            cpus = 2
            memory = "4 GB"
            time = "4h"
        }
    }
}

apptainer {
    enabled = true
    autoMounts = true
}

cleanup = true
