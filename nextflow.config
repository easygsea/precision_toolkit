profiles {
    standard {
        process {
            executor = 'local'
            cpus = 2
            memory = '4 GB'
        }
    }
}

params {
    // Directory storing output files
    output_dir = "output_clinical_tools"
    concordance_dir = "concordance"  // subdirectory for concordance outputs

    // Genome reference fasta file
    genome_ref = "/projects/alignment_references/Homo_sapiens/hg38_no_alt/genome/fasta/hg38_no_alt.fa"

    // Concordance module parameters
    truth_dir = null // directory containing truth VCFs
    query_dir = null // directory containing query VCFs
    variant_concordance_engine = "happy" // default happy
    happy_options = '--write-vcf --write-counts' // default options for happy
    wittyer_options = '' // default options for wittyer, if any

    // Resource limits
    max_memory = '64.GB'
    max_cpus = 16
}

process {
    container = "quay.io/easygsea/clinical_tools:latest"
    withLabel: 'dynamic_resource' {
        cpus = { 
            if (task.attempt == 1) return 4
            if (task.attempt == 2) return 6
            return Math.min(8, params.max_cpus ?: 8)
        }
        
        memory = {
            if (task.attempt == 1) return '8 GB'
            if (task.attempt == 2) return '16 GB'
            return '32 GB'
        }
        
        time = {  
            if (task.attempt == 1) return '4h'
            if (task.attempt == 2) return '8h'
            return '12h'
        }             
        
        errorStrategy = {
            switch(task.exitStatus) {
                case 104: return 'retry'  // Disk quota exceeded
                case 134: return 'retry'  // Assert failed
                case 137: return 'retry'  // Out of memory
                case 139: return 'retry'  // Segmentation fault
                case 140: return 'retry'  // Aborted
                case 143: return 'retry'  // Timeout 
                default: return 'terminate'
            }
        }
    }
    maxRetries = 3
}

singularity {
    enabled = true
    autoMounts = true
}

cleanup = true
