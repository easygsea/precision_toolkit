params {
    // Input parameters
    truth_dir = null // Directory containing truth VCFs
    query_dir = null // Directory containing query VCFs
    output_dir = "output_clinical_tools" // Directory storing output files
    genome_ref = "/projects/alignment_references/Homo_sapiens/hg38_no_alt/genome/fasta/hg38_no_alt.fa"
    variant_concordance_engine = "happy" // Analysis engine: happy or wittyer
}

process.container = "quay.io/easygsea/clinical_tools:latest"

singularity.enabled = true
singularity.autoMounts = true

cleanup = true
