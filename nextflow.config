// Variant concordance analysis engine: happy or wittyer
enum VariantConcordanceEngine {
    happy, wittyer
}

params {
    // Input parameters
    truth_dir = null // directory containing truth VCFs
    query_dir = null // directory containing query VCFs
    output_dir = "output_clinical_tools" // directory storing output files
    genome_ref = "/projects/alignment_references/Homo_sapiens/hg38_no_alt/genome/fasta/hg38_no_alt.fa"
    variant_concordance_engine = "happy" // default happy
    happy_options = '--write-vcf --write-counts' // default options for happy
    wittyer_options = '' // default options for wittyer, if any
    
    // Resource limits
    max_memory = '64.GB'
    max_cpus = 16
    
    // Execution options
    force = false // whether to overwrite existing output directory
}

def valid_engines = VariantConcordanceEngine.values()*.toString()
if (!(params.variant_concordance_engine in valid_engines)) {
    throw new IllegalArgumentException(
        "Invalid 'variant_concordance_engine': ${params.variant_concordance_engine}. " +
        "Please input a valid engine. Valid options are: ${valid_engines.join(', ')}"
    )
}

process {
    container = "quay.io/easygsea/clinical_tools:latest"
    withName: run_happy {
        cpus = { 
            def vcf_size = task.inputs[0].size()
            if (vcf_size < 100.MB) return 2
            if (vcf_size < 1.GB) return 4
            return Math.min(8, params.max_cpus)
        }
        memory = {
            def vcf_size = task.inputs[0].size()
            if (vcf_size < 100.MB) return '8 GB'
            if (vcf_size < 1.GB) return '16 GB'
            return Math.min('32 GB', params.max_memory)
        }
        time = {
            // Start with shorter time
            if (task.attempt == 1) return '4h'
            // Increase if needed
            if (task.attempt == 2) return '8h'
            // Maximum allowed time
            return '12h'
        }
        errorStrategy = {
            switch(task.exitStatus) {
                case 104: // Disk quota exceeded
                    return 'retry'
                case 134: // Assert failed
                    return 'retry'
                case 137: // Out of memory
                    return 'retry'
                case 139: // Segmentation fault
                    return 'retry'
                case 140: // Aborted
                    return 'retry'
                case 143: // Timeout
                    return 'retry'
                default:
                    return 'terminate'
            }
        }
    }
    withName: run_wittyer {
        cpus = { 
            def vcf_size = task.inputs[0].size()
            if (vcf_size < 100.MB) return 2
            if (vcf_size < 1.GB) return 4
            return Math.min(8, params.max_cpus)
        }
        memory = {
            def vcf_size = task.inputs[0].size()
            if (vcf_size < 100.MB) return '8 GB'
            if (vcf_size < 1.GB) return '16 GB'
            return Math.min('32 GB', params.max_memory)
        }
        time = {
            if (task.attempt == 1) return '2h'
            if (task.attempt == 2) return '4h'
            return '8h'
        }
        errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'terminate' }
    }
    maxRetries = 3
}

profiles {
    standard {
        process {
            executor = 'local'
            cpus = 2
            memory = '4 GB'
        }
    }
}

singularity {
    enabled = true
    autoMounts = true
    runOptions = '--nv'  // Enable NVIDIA support if needed
}

cleanup = true