nextflow_workflow {

    name: 'Test Variant Benchmark Workflow'
    script "../main.nf"
    workflow "variant_benchmark"

    tag "subworkflows"
    tag "variant_benchmark_workflow"

    test('hap.py raw') {
        when {
            workflow {
                """
                variant_benchmark_engine = 'happy'
                truth_dir = 'data/snv_truth_vcfs'
                query_dir = 'data/snv_query_vcfs'
                genome_ref = 'data/genome.fasta'
                skip_raw = false
                collapse = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    workflow.out.summary_files,
                    workflow.out.summary_files_curated,
                    workflow.out.variant_benchmark_summary).match() }
            )
        }
    }

    test('hap.py raw and curated') {
        when {
            workflow {
                """
                variant_benchmark_engine = 'happy'
                truth_dir = 'data/snv_truth_vcfs'
                query_dir = 'data/snv_query_vcfs'
                genome_ref = 'data/genome.fasta'
                skip_raw = false
                spurious_variants_vcf = 'data/spurious_snv.vcf'
                collapse = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    workflow.out.summary_files,
                    workflow.out.summary_files_curated,
                    workflow.out.variant_benchmark_summary).match() }
            )
        }
    }

    test('hap.py raw and curated - skip raw') {
        when {
            workflow {
                """
                variant_benchmark_engine = 'happy'
                truth_dir = 'data/snv_truth_vcfs'
                query_dir = 'data/snv_query_vcfs'
                genome_ref = 'data/genome.fasta'
                skip_raw = true
                spurious_variants_vcf = 'data/spurious_snv.vcf'
                collapse = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    workflow.out.summary_files_curated,
                    workflow.out.variant_benchmark_summary).match() }
            )
        }
    }

    test('witty.er raw') {
        when {
            workflow {
                """
                variant_benchmark_engine = 'wittyer'
                truth_dir = 'data/cnv_truth_vcfs'
                query_dir = 'data/cnv_query_vcfs'
                genome_ref = ''
                skip_raw = false
                collapse = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    workflow.out.summary_files,
                    workflow.out.summary_files_curated,
                    workflow.out.variant_benchmark_summary).match() }
            )
        }
    }

    test('witty.er raw and curated') {
        when {
            workflow {
                """
                variant_benchmark_engine = 'wittyer'
                truth_dir = 'data/cnv_truth_vcfs'
                query_dir = 'data/cnv_query_vcfs'
                genome_ref = ''
                skip_raw = false
                spurious_variants_vcf = 'data/spurious_cnv.vcf'
                collapse = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    workflow.out.summary_files,
                    workflow.out.summary_files_curated,
                    workflow.out.variant_benchmark_summary).match() }
            )
        }
    }

    test('witty.er raw and curated - skip raw') {
        when {
            workflow {
                """
                variant_benchmark_engine = 'wittyer'
                truth_dir = 'data/cnv_truth_vcfs'
                query_dir = 'data/cnv_query_vcfs'
                genome_ref = ''
                skip_raw = true
                spurious_variants_vcf = 'data/spurious_cnv.vcf'
                collapse = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    workflow.out.summary_files_curated,
                    workflow.out.variant_benchmark_summary).match() }
            )
        }
    }
}
