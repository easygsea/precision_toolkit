Bootstrap: docker
From: mcr.microsoft.com/dotnet/sdk:{{ DOTNET_VERSION }}
Stage: witty_er_builder

%arguments
    DOTNET_VERSION=6.0
    WITTYER_VERSION=0.5.2

%post
    mkdir /opt/witty.er
    cd /opt/witty.er
    apt-get update && apt-get install -y --no-install-recommends git
    rm -rf /var/lib/apt/lists/*
    git clone https://github.com/Illumina/witty.er.git .
    git checkout tags/v{{ WITTYER_VERSION }} -b v{{ WITTYER_VERSION }}-build
    cd Wittyer && \
    dotnet publish . -c Release

Bootstrap: docker
From: python:{{ PYTHON_VERSION }}-slim-bookworm
Stage: clinical_tools_builder

%arguments
    PYTHON_VERSION=3.11.7
    POETRY_VERSION=2.0.1

%files
    README.md app/
    pyproject.toml app/
    poetry.lock app/
    src/ app/

%post
    cd /app
    pip install --upgrade pip --no-cache-dir && \
    pip install --no-cache-dir "poetry=={{ POETRY_VERSION }}" && \
    poetry config virtualenvs.create false && \
    poetry build && \
    chmod a+rx /app -R

Bootstrap: docker
From: mgibio/hap.py:v{{ HAPPY_VERSION }}
Stage: runtime1

%arguments
    BEDTOOLS_VERSION=2.31.0
    DOTNET_VERSION=6.0
    HAPPY_VERSION=0.3.15
    HTSLIB_VERSION=1.21
    JOBLIB_VERSION=0.14.1
    PSUTIL_VERSION=6.1.1
    PYTHON_VERSION=3.11.7
    NEXTFLOW_VERSION=24.10.3

%files from witty_er_builder
    /opt/witty.er/Wittyer/ /witty.er

%files from clinical_tools_builder
    /app/dist/*.whl app/

%environment
    export PATH="$PATH:/opt/hap.py/bin:/witty.er/bin:/opt/hap.py/libexec/rtg-tools-install"
    export PATH="$PATH:/usr/bin"

%post
    cd app && \
    pip install --upgrade --no-cache-dir "joblib=={{ JOBLIB_VERSION }}" "psutil=={{ PSUTIL_VERSION }}" && \
    pip uninstall --y cryptography cvxopt idna lxml numexpr pillow pip py pyxdg pycrypto setuptools && \
    apt-get update && apt-get upgrade -y && \
    apt-get install software-properties-common && \
    add-apt-repository ppa:ubuntu-toolchain-r/test && \
    apt-get install -y --no-install-recommends  \
    gawk \
    apt-transport-https \
    build-essential \
    gcc-10 \
    g++-10 \
    libbz2-dev \
    libdb5.3-dev \
    libexpat1-dev \
    libffi-dev \
    libgdbm-dev \
    liblzma-dev \
    libncurses5-dev \
    libncursesw5-dev \
    libreadline-dev \
    libsqlite3-dev \
    libssl-dev \
    software-properties-common \
    wget \
    zlib1g-dev && \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-10 100 --slave /usr/bin/g++ g++ /usr/bin/g++-10 && \
    wget --quiet "https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb" && \
    dpkg -i packages-microsoft-prod.deb && \
    apt-get update && apt-get install -y --no-install-recommends "dotnet-sdk-{{DOTNET_VERSION}}" && \
    # Build htslib (dependency for bcftools and samtools)
    wget --quiet "https://github.com/samtools/htslib/releases/download/{{HTSLIB_VERSION}}/htslib-{{HTSLIB_VERSION}}.tar.bz2" && \
    tar -xjf "htslib-{{ HTSLIB_VERSION }}.tar.bz2" && \
    cd "htslib-{{ HTSLIB_VERSION }}" && \
    ./configure --prefix=/opt/hap.py && \
    make && make install && \
    # Build bcftools
    wget --quiet "https://github.com/samtools/bcftools/releases/download/{{ HTSLIB_VERSION }}/bcftools-{{ HTSLIB_VERSION }}.tar.bz2" && \
    tar -xjf "bcftools-{{ HTSLIB_VERSION }}.tar.bz2" && \
    cd "bcftools-{{ HTSLIB_VERSION }}" && \
    ./configure --prefix=/opt/hap.py && \
    make && make install && \
    cd ../.. && rm -rf htslib-* samtools-* bcftools-* && \
    # Build samtools
    wget --quiet "https://github.com/samtools/samtools/releases/download/{{HTSLIB_VERSION}}/samtools-{{HTSLIB_VERSION}}.tar.bz2" && \
    tar -xjf "samtools-{{HTSLIB_VERSION}}.tar.bz2" && \
    cd "samtools-{{HTSLIB_VERSION}}" && \
    ./configure --prefix=/opt/hap.py && \
    make && make install && \
    # Install precompiled bedtools
    wget --quiet "https://github.com/arq5x/bedtools2/releases/download/v{{BEDTOOLS_VERSION}}/bedtools.static" && \
    chmod a+x bedtools.static && \
    mv bedtools.static /opt/hap.py/bin/bedtools && \
    # Build Python
    wget --quiet "https://www.python.org/ftp/python/{{ PYTHON_VERSION }}/Python-{{ PYTHON_VERSION }}.tgz" && \
    tar -xzf "Python-{{ PYTHON_VERSION }}.tgz" && \
    cd "Python-{{ PYTHON_VERSION }}" && \
    ./configure --enable-optimizations && \
    make -j "$(nproc)" && \
    make install && cd .. && rm -rf "Python-{{ PYTHON_VERSION }}" "Python-{{ PYTHON_VERSION }}.tgz" && \
    apt-get remove --purge -y wget apt-transport-https software-properties-common build-essential && \
    apt-get autoremove -y && apt-get clean && rm -rf /var/lib/apt/lists/* && \
    cd ../.. && \
    cd app && \
    find /opt/hap.py/bin -type f -name "*.py" -exec sed -i 's~#!/usr/bin/python~#!/usr/bin/env python2.7~' {} \; && \
    printf '#!/bin/bash\ndotnet /witty.er/bin/Release/net6.0/Wittyer.dll "$@"\n' > /witty.er/bin/witty.er && \
    chmod +x /witty.er/bin/witty.er && \
    update-alternatives --install /usr/bin/python python /usr/local/bin/python3 1 && \
    update-alternatives --install /usr/bin/pip pip /usr/local/bin/pip3 1 && \
    python -m pip install --no-cache-dir --upgrade pip setuptools && \
    pip install --no-cache-dir ./*.whl && \
    # Install dev dependencies
    pip install --no-cache-dir pytest=8.3.4 pytest-cov=4.0.0 pytest-workflow=2.0.1 pytest-xdist=3.6.1 pyproject-pre-commit=0.4.1 && \
    pip2 uninstall -y bx-python && \
    rm -rf /usr/local/lib/python2.7/dist-packages/bx* && \
    rm -rf /usr/local/lib/python2.7/dist-packages/bx_python* && \
    python2.7 -m pip install --no-cache-dir bx-python --no-binary bx-python && \
    rm *.whl && \
    # CDI-158
    sed -i 's~True,  # pass_only~not args.inc_nonpass, # account for nonpass in truth vcf~' /opt/hap.py/bin/som.py
